<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="WebVideoDB_24110013" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>vn.iotstar.entity.User_24110013</class>
        <class>vn.iotstar.entity.Category_24110013</class>
        <class>vn.iotstar.entity.Video_24110013</class>
        <class>vn.iotstar.entity.Favorite_24110013</class>
        <class>vn.iotstar.entity.Share_24110013</class>
        <class>vn.iotstar.entity.Order_24110013</class>
        <class>vn.iotstar.entity.OrderDetail_24110013</class>

        <properties>
            <!-- Database Connection -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://localhost:1433;databaseName=WebVideoDB_24110013;encrypt=false;trustServerCertificate=true;"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="0373703896Hao@"/>

            <!-- Hibernate 6 tự động nhận diện SQLServerDialect từ JDBC URL, bỏ cấu hình tường minh để sạch log -->
            <!-- <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/> -->

            <!-- DDL: none (Dữ liệu đã có sẵn trong SQL Server) -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <!-- Hiển thị SQL ra console -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
